# Database (Postgres connection string used by Prisma)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# GitHub API (used for repository import/analysis; a token raises rate limits, optional for public repos)
GITHUB_TOKEN=

# Rate limiting (Upstash Redis) — optional; without these, an in-memory
# fallback is used, which only works correctly on a single, persistent
# Node process (not on Vercel/serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI provider (semantic architecture generation) ---
# AI_PROVIDER selects which backend generates the semantic architecture graph.
# Deterministic repository analysis always stays local to CodeMap — the model
# only groups, labels, and explains facts CodeMap already extracted.
#
# Local development: AI_PROVIDER=ollama
#   Talks to a locally-running Ollama instance. Not reachable in production
#   (e.g. Vercel), so never set this in a deployed environment.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
#
# Production (e.g. Vercel): AI_PROVIDER=gateway
#   Routes through Vercel AI Gateway via the AI SDK. AI_MODEL is a Gateway
#   model id in "creator/model" form (e.g. "anthropic/claude-sonnet-4-5").
#   AI_GATEWAY_API_KEY is auto-provided on Vercel when AI Gateway is enabled
#   for the project; set it explicitly for local testing of this path only.
# AI_PROVIDER=gateway
# AI_MODEL=anthropic/claude-sonnet-4-5
# AI_GATEWAY_API_KEY=
